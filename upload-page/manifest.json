{
  "name": "FamilyFrame Upload",
  "short_name": "FamilyFrame",
  "description": "Fotos fuer Omas Bilderrahmen hochladen",
  "start_url": "/index.html",
  "display": "standalone",
  "background_color": "#0f0f1a",
  "theme_color": "#1a1a2e",
  "orientation": "any",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/index.html?share=true",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "caption",
      "text": "description",
      "files": [
        {
          "name": "photos",
          "accept": ["image/jpeg", "image/png", "image/heic", "image/heif", "image/webp", "image/*"]
        }
      ]
    }
  },
  "categories": ["photo"]
}
